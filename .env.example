# Шаблон для секретов. Скопируй в .env (он в .gitignore) и заполни только нужное.
# Значения никогда не печатаются в чат и не попадают в чек-листы.

# Jira и Confluence — свои MCP-серверы только на чтение (mcp-jira/, mcp-confluence/),
# один и тот же API-токен вместо браузерного OAuth (официальный Atlassian MCP не смог
# пройти вход в текущем типе сессии). Токен: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# CONFLUENCE_URL=   # задать, только если Confluence на другом адресе, чем JIRA_URL

# Test IT — mcp-testit/
TESTIT_BASE_URL=
TESTIT_PROJECT_ID=
TESTIT_TOKEN=

# Тестовый стенд бэкенда (если есть доступ для фазы 2)
STAND_API_URL=
STAND_API_TOKEN=
